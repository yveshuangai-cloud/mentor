# ── 必填 ─────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/mantou_platform
# DB_SSL=true

# ── 服務 ─────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-random-32char-min-secret
ADMIN_TOKEN=change-me-admin-token

# ── 商用 LINE OA（獨立帳號，絕不用本尊的）──────
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# ── LLM ─────────────────────────────
# 二選一：BRIDGE_SECRET 有值 → 走 zhu-bridge（開發期，吃 Max 月費）；
#         否則用 ANTHROPIC_API_KEY 直連（量產／多模態必須）。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
BRIDGE_SECRET=
BRAIN_MODEL=claude-sonnet-5
EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# ── 語音／多模態 ─────────────────────
GEMINI_API_KEY=
MINIMAX_API_KEY=
# MiniMax 國際版通常留空；僅舊帳號／舊端點要求時填入。
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
DEEPGRAM_API_KEY=
VOICE_BUCKET=mantou-voice-2026

# 即時通話正式整合時，饅頭必須使用獨立 LiveKit project，不能與其他人格共用。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cron（Cloud Scheduler 打 /api/cron/* 用；本地開發可留空）──
CRON_SECRET=

# ── 金流（LINE Pay；藍新/綠界之後照 provider 介面補）──
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_SANDBOX=true
