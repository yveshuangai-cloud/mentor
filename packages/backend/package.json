{
  "name": "@mantou-platform/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:voice": "node dist/voiceIndex.js",
    "start:livekit-agent": "node dist/livekitAgent.js start",
    "test": "vitest run",
    "acceptance": "tsx scripts/acceptance.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "soul:build": "tsx scripts/build-soul-manifest.ts",
    "soul:lint": "tsx scripts/lint-pack.ts mantou",
    "predeploy": "npm run soul:build && npm run soul:lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@livekit/agents": "^1.6.2",
    "@livekit/agents-plugin-deepgram": "^1.6.2",
    "@livekit/protocol": "^1.50.4",
    "@livekit/rtc-node": "^0.13.33",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "livekit-server-sdk": "^2.17.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
